# Memer Core configuration
# Use "mock" for API development or "ollama" for a local model runtime.
MEMER_PROVIDER=mock
MEMER_MODEL_NAME=memer-dev-mock
MEMER_HOST=127.0.0.1
MEMER_PORT=8000

# Ollama settings (used when MEMER_PROVIDER=ollama)
MEMER_OLLAMA_BASE_URL=http://127.0.0.1:11434
MEMER_REQUEST_TIMEOUT=120
