MEMER_PROVIDER=mock
MEMER_MODEL_NAME=memer-dev-mock
MEMER_HOST=127.0.0.1
MEMER_PORT=8000
MEMER_REQUEST_TIMEOUT=120
MEMER_OLLAMA_BASE_URL=http://127.0.0.1:11434

# Native Memer Transformer provider
# MEMER_PROVIDER=native
# MEMER_MODEL_NAME=memer-transformer
# MEMER_CHECKPOINT_PATH=checkpoints/memer-small.json
# MEMER_MAX_NEW_TOKENS=80
# MEMER_TEMPERATURE=0.8
# MEMER_SEED=17

# Browser origins allowed to call this API. Add your deployed Memer Public URL.
MEMER_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Hosted Memer Runtime security
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
# Keep API keys in the hosting provider's secret store, never in Git.
# MEMER_ENV=production
# MEMER_API_KEYS=replace-with-a-random-secret-of-at-least-32-characters
# MEMER_REQUIRE_API_KEY=true
# MEMER_MAX_INPUT_CHARS=12000
# MEMER_MAX_CONCURRENT_GENERATIONS=1
